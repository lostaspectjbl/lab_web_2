<%- include('partials/header', { title: 'Lab 08 - Stored XSS in anchor href attribute', currentLab: 'lab08' }) %>

<div class="lab-banner">
  <div class="lab-meta">
    <span class="lab-pill">Lab 08</span>
    <span>Stored Attribute XSS</span>
  </div>
  <h1 class="lab-title">Stored XSS into anchor href attribute with double quotes HTML-encoded</h1>
  <p class="lab-description">
    Lab ini berisi kerentanan Stored Cross-Site Scripting pada kolom "Website" form komentar.
    Aplikasi meng-encode tanda kutip ganda (<code>"</code>) pada URL website, namun tidak memvalidasi skema URL (seperti <code>javascript:</code>).
  </p>
</div>

<article class="card">
  <header class="post-header">
    <h2 class="post-title"><%= post.title %></h2>
    <div class="post-meta">
      By <strong><%= post.author %></strong> &bull; Published on <%= post.created_at %>
    </div>
  </header>
  <div class="post-content">
    <p><%= post.content %></p>
  </div>
</article>

<section class="card comments-section">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h3 class="comments-header" style="margin-bottom: 0;">
      <span>Comments (<%= comments.length %>)</span>
    </h3>
    <form action="/lab08/reset" method="POST" style="display: inline;">
      <button type="submit" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">Reset Comments</button>
    </form>
  </div>

  <div class="comment-list">
    <% if (comments.length === 0) { %>
      <p style="color: var(--text-muted);">No comments yet.</p>
    <% } else { %>
      <% comments.forEach(comment => { %>
        <div class="comment-item">
          <div class="comment-author">
            <span>
              <% if (comment.website) { %>
                <!-- VULNERABLE ANCHOR SINK: Double quotes encoded, but URL scheme not validated -->
                <a id="author-link-<%= comment.id %>" href="<%- comment.website %>" style="color: var(--primary-color); font-weight: 700; text-decoration: underline;">
                  <%= comment.author %>
                </a>
              <% } else { %>
                <strong><%= comment.author %></strong>
              <% } %>
            </span>
            <span class="comment-date"><%= comment.created_at %></span>
          </div>
          <!-- Body komentar di-encode dengan aman menggunakan <%= %> -->
          <div class="comment-body">
            <%= comment.content %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1.5rem;">
    <h4 style="margin-bottom: 1rem; font-size: 1.15rem;">Leave a Comment</h4>
    <form action="/lab08/comment" method="POST">
      <input type="hidden" name="postId" value="<%= post.id %>">
      
      <div class="form-group">
        <label for="author" class="form-label">Name</label>
        <input type="text" id="author" name="author" class="form-input" placeholder="Your name" required maxlength="100">
      </div>

      <div class="form-group">
        <label for="website" class="form-label">Website (Optional)</label>
        <input type="text" id="website" name="website" class="form-input" placeholder="https://yourwebsite.com">
        <small style="color: var(--text-muted); font-size: 0.8rem;">Nama komentator akan menjadi tautan yang mengarah ke website ini.</small>
      </div>

      <div class="form-group">
        <label for="content" class="form-label">Comment</label>
        <textarea id="content" name="content" class="form-textarea" placeholder="Write your thoughts..." required rows="4"></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
