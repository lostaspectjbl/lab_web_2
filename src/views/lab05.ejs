<%- include('partials/header', { title: 'Contact — ByteNote', currentPage: 'contact' }) %>

<div class="page-wrap">
  <div class="page-header">
    <div class="page-header-eyebrow">Get in Touch</div>
    <h1>Contact ByteNote</h1>
    <p>Have a question, article pitch, or correction? Send us a message and we will get back to you within two business days.</p>
  </div>

  <div class="feedback-container">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <form action="/lab05/feedback" method="POST">
      <div class="form-group">
        <label for="name">Your Name</label>
        <input type="text" id="name" name="name" placeholder="Full name" required maxlength="100">
      </div>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required maxlength="200">
      </div>
      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" placeholder="Article pitch, correction, general inquiry..." required maxlength="200">
      </div>
      <div class="form-group">
        <label for="body">Message</label>
        <textarea id="body" name="body" placeholder="Your message..." required maxlength="2000" style="min-height:140px;"></textarea>
      </div>

      <div class="feedback-nav">
        <button type="submit" class="btn btn-primary">Send Message</button>
        <a id="backLink" href="/" class="btn btn-secondary">Go Back</a>
      </div>
    </form>
  </div>
</div>

<!-- Sets the Back button href from returnPath query parameter -->
<script src="/js/vendor/jquery-1.8.3.min.js"></script>
<script>
  (function($) {
    var params = new URLSearchParams(location.search);
    var returnPath = params.get('returnPath');
    if (returnPath) {
      $('#backLink').attr('href', returnPath);
    }
  })(jQuery);
</script>

<%- include('partials/footer') %>
