<%- include('partials/header', { title: 'Contact — ByteNote', currentPage: 'contact' }) %>

<div class="page-wrap wide">
  <div class="layout-cols">
    <main>
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Contact</span>
      </div>

      <div class="page-header">
        <div class="page-header-eyebrow">Get in Touch</div>
        <h1>Contact ByteNote</h1>
        <p>Have a question, article pitch, or correction? Send us a message and we will get back to you within two business days.</p>
      </div>

      <% if (typeof submitted !== 'undefined' && submitted) { %>
        <div class="alert alert-success" style="margin-bottom:1.5rem;">
          Thank you for your message! We will get back to you within two business days.
        </div>
      <% } %>

      <div class="feedback-container">
        <form action="/lab05/feedback" method="POST">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="Full name" required maxlength="100">
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required maxlength="200">
          </div>
          <div class="form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" placeholder="Article pitch, correction, general inquiry..." required maxlength="200">
          </div>
          <div class="form-group">
            <label for="body">Message</label>
            <textarea id="body" name="body" placeholder="Your message..." required maxlength="2000" style="min-height:140px;"></textarea>
          </div>

          <div class="feedback-nav">
            <button type="submit" class="btn btn-primary">Send Message</button>
            <a id="backLink" href="/" class="btn btn-secondary">Go Back</a>
          </div>
        </form>
      </div>
    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Other Ways to Reach Us</div>
        <ul class="sidebar-article-list">
          <li class="sidebar-article-item">
            <strong style="font-size:0.82rem;color:var(--color-text);">Editorial</strong>
            <div class="sidebar-article-item-meta">editorial@bytenote.example</div>
          </li>
          <li class="sidebar-article-item">
            <strong style="font-size:0.82rem;color:var(--color-text);">Security Disclosures</strong>
            <div class="sidebar-article-item-meta">security@bytenote.example</div>
          </li>
          <li class="sidebar-article-item">
            <strong style="font-size:0.82rem;color:var(--color-text);">Advertising</strong>
            <div class="sidebar-article-item-meta">ads@bytenote.example</div>
          </li>
        </ul>
      </div>
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Response Time</div>
        <p style="font-size:0.82rem;color:var(--color-text-secondary);line-height:1.6;">We aim to respond to all messages within two business days. For urgent security issues, email us directly.</p>
      </div>
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">About ByteNote</div>
        <p style="font-size:0.82rem;color:var(--color-text-secondary);line-height:1.6;">ByteNote is an independent publication covering cybersecurity and web technology. <a href="/about">Learn more about us.</a></p>
      </div>
    </aside>
  </div>
</div>

<!-- Sets the Back button href from returnPath query parameter — intentional jQuery XSS sink -->
<script src="/js/vendor/jquery-1.8.3.min.js"></script>
<script>
  (function($) {
    var params = new URLSearchParams(location.search);
    var returnPath = params.get('returnPath');
    if (returnPath) {
      $('#backLink').attr('href', returnPath);
    }
  })(jQuery);
</script>

<%- include('partials/labsolver') %>
<%- include('partials/footer') %>
