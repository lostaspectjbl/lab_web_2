<%- include('partials/header', { title: 'Challenge Helper — ByteNote', currentPage: '' }) %>

<div class="page-wrap">
  <div class="page-header">
    <div class="page-header-eyebrow">Tool</div>
    <h1>Challenge Helper</h1>
    <p>Save a custom HTML document and get a persistent URL on a separate origin. Use this URL as your exploit server for challenges that require delivering a payload from an external page.</p>
  </div>

  <div class="helper-panel">
    <% if (typeof savedUrl !== 'undefined' && savedUrl) { %>
    <div class="alert alert-success" style="margin-bottom:1.5rem;">
      Your page has been saved. Share this URL with the bot:
      <div class="helper-url-display"><%= savedUrl %></div>
      <a href="<%= savedUrl %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="margin-top:0.5rem;">Preview Page</a>
    </div>
    <% } %>

    <form action="/helper" method="POST">
      <div class="form-group">
        <label for="team_id">Team ID</label>
        <input type="text" id="team_id" name="team_id"
               placeholder="your-team-id"
               value="<%= typeof teamId !== 'undefined' ? teamId : '' %>"
               required maxlength="40"
               pattern="[a-zA-Z0-9_-]+"
               title="Letters, numbers, hyphens and underscores only">
        <span class="form-hint">Your team identifier. Only letters, numbers, hyphens, and underscores.</span>
      </div>
      <div class="form-group">
        <label for="html_content">HTML Document</label>
        <textarea id="html_content" name="html_content"
                  class="helper-code-area form-group textarea"
                  placeholder="&lt;!DOCTYPE html&gt;&#10;&lt;html&gt;...&lt;/html&gt;"
                  required maxlength="10240"><%= typeof htmlContent !== 'undefined' ? htmlContent : '' %></textarea>
        <span class="form-hint">Maximum 10 KB. This document will be served as text/html from a separate origin.</span>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <button type="submit" class="btn btn-primary">Save &amp; Get URL</button>
    </form>
  </div>

  <% if (typeof existingUrl !== 'undefined' && existingUrl) { %>
  <div style="margin-top:1.5rem;">
    <div class="text-muted">Currently saved page for team <strong><%= typeof teamId !== 'undefined' ? teamId : '' %></strong>:</div>
    <div class="helper-url-display"><%= existingUrl %></div>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
