<%- include('partials/header', { title: 'Search — ByteNote', currentPage: '' }) %>

<div class="page-wrap wide">
  <div class="layout-cols">
    <main>
      <div class="page-header">
        <div class="page-header-eyebrow">Search</div>
        <h1>Search Articles</h1>
      </div>

      <div class="search-hero">
        <div class="search-label">What are you looking for?</div>
        <form class="search-hero-form" action="/lab04" method="get" autocomplete="off">
          <input type="text" name="search" placeholder="Search articles, topics, authors..." value="<%= typeof search !== 'undefined' ? search : '' %>">
          <button type="submit">Search</button>
        </form>
      </div>

      <div id="search-banner"></div>

      <% if (posts && posts.length > 0) { %>
      <div class="blog-list" style="margin-top:1.5rem;">
        <% posts.forEach(function(post) { %>
        <div class="blog-list-item">
          <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-accent);margin-bottom:0.4rem;"><%= post.category %></div>
          <h2><a href="/articles/<%= post.id %>"><%= post.title %></a></h2>
          <div class="blog-list-excerpt"><%= post.excerpt %></div>
          <div class="blog-list-meta">
            <span><%= post.author %></span>
            <span>&middot;</span>
            <span><%= post.read_time %> min read</span>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Topics</div>
        <div class="sidebar-tags">
          <a href="/lab04?search=xss" class="tag">XSS</a>
          <a href="/lab04?search=csp" class="tag">CSP</a>
          <a href="/lab04?search=dom" class="tag">DOM Security</a>
          <a href="/lab04?search=encoding" class="tag">Output Encoding</a>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Dynamic search results banner via innerHTML -->
<script>
  (function() {
    var params = new URLSearchParams(location.search);
    var query = params.get('search');
    if (query) {
      var banner = document.getElementById('search-banner');
      banner.innerHTML = '<div class="search-results-header">Showing results for: ' + query + '</div>';
    }
  })();
</script>

<%- include('partials/footer') %>
