<%- include('partials/header', { title: 'Lab 04 - DOM XSS in innerHTML sink', currentLab: 'lab04' }) %>

<div class="lab-banner">
  <div class="lab-meta">
    <span class="lab-pill">Lab 04</span>
    <span>DOM-based XSS</span>
  </div>
  <h1 class="lab-title">DOM XSS in innerHTML sink using source location.search</h1>
  <p class="lab-description">
    Lab ini berisi kerentanan DOM-based Cross-Site Scripting pada fitur pencarian blog dinamis.
    Skrip sisi klien membaca parameter query dari <code>location.search</code> dan memasukkan nilainya ke dalam
    elemen DOM menggunakan sink <code>innerHTML</code> tanpa proses sanitasi.
  </p>
</div>

<div class="card">
  <form action="/lab04" method="GET" class="search-form">
    <input 
      type="text" 
      name="search" 
      placeholder="Search blog posts..." 
      value="<%= search !== null ? search : '' %>"
      class="form-input"
    >
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <!-- Container hasil pencarian dinamis yang diisi oleh script klien via innerHTML -->
  <div id="searchMessage" class="search-results-banner" style="display: none; margin-top: 1.5rem;"></div>

  <script>
    function displaySearchQuery() {
      var query = (new URLSearchParams(window.location.search)).get('search');
      if (query) {
        var banner = document.getElementById('searchMessage');
        banner.style.display = 'block';
        // VULNERABLE DOM SINK: innerHTML populated directly from location.search
        banner.innerHTML = '<h3>Results for: ' + query + '</h3>';
      }
    }
    window.addEventListener('DOMContentLoaded', displaySearchQuery);
  </script>

  <% if (search !== null) { %>
    <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <% if (results.length > 0) { %>
        <% results.forEach(post => { %>
          <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #fafafa;">
            <h4 style="margin-bottom: 0.35rem; color: var(--text-main);"><%= post.title %></h4>
            <p style="font-size: 0.9rem; color: var(--text-muted);"><%= post.content %></p>
          </div>
        <% }); %>
      <% } else { %>
        <p style="color: var(--text-muted); font-size: 0.95rem;">No matching articles found in blog archives.</p>
      <% } %>
    </div>
  <% } else { %>
    <div style="margin-top: 1.5rem;">
      <p style="color: var(--text-muted);">Gunakan kolom di atas untuk mencari artikel blog.</p>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
