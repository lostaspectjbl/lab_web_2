<%- include('partials/header', { title: 'Articles — ByteNote', currentPage: 'articles' }) %>

<div class="page-wrap wide">
  <div class="layout-cols">
    <main>
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Articles</span>
      </div>

      <div class="page-header">
        <div class="page-header-eyebrow">Archive</div>
        <h1>All Articles</h1>
        <p>Browse our complete archive. Use the topic links in the sidebar or the URL hash to jump to a specific article.</p>
      </div>

      <div class="blog-list">
        <% posts.forEach(function(post) { %>
        <section class="blog-list">
          <div class="blog-list-item">
            <div class="blog-list-category"><%= post.category %></div>
            <h2><a href="/articles/<%= post.id %>"><%= post.title %></a></h2>
            <div class="blog-list-excerpt"><%= post.excerpt %></div>
            <div class="blog-list-meta">
              <span><%= post.author %></span>
              <span>&middot;</span>
              <span><%= post.read_time %> min read</span>
              <span>&middot;</span>
              <span><%= new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>
          </div>
        </section>
        <% }); %>
      </div>

    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Jump to Article</div>
        <p style="font-size:0.78rem;color:var(--color-text-secondary);margin-bottom:0.75rem;line-height:1.5;">Click a title below to scroll directly to that article on this page.</p>
        <ul class="sidebar-article-list">
          <% posts.forEach(function(post) { %>
          <li class="sidebar-article-item">
            <a href="#<%= encodeURIComponent(post.title) %>"><%= post.title %></a>
            <div class="sidebar-article-item-meta"><%= post.author %> &middot; <%= post.read_time %> min</div>
          </li>
          <% }); %>
        </ul>
      </div>

      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Topics</div>
        <div class="sidebar-tags">
          <a href="/articles" class="tag">XSS</a>
          <a href="/articles" class="tag">CSP</a>
          <a href="/articles" class="tag">DOM Security</a>
          <a href="/articles" class="tag">jQuery</a>
          <a href="/articles" class="tag">Penetration Testing</a>
          <a href="/articles" class="tag">Output Encoding</a>
        </div>
      </div>

      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Newsletter</div>
        <p class="newsletter-desc">Get new articles in your inbox every week.</p>
        <div class="newsletter-form">
          <input type="email" placeholder="your@email.com">
          <button type="button">Subscribe</button>
        </div>
      </div>
    </aside>
  </div>
</div>

<script src="/js/vendor/jquery-1.8.3.min.js"></script>
<script>
  // Auto-scroll to article matching the URL hash on hashchange — intentional jQuery selector XSS sink
  $(window).on('hashchange', function() {
    var hash = decodeURIComponent(location.hash.slice(1));
    if (!hash) return;
    var target = $('section.blog-list h2:contains(' + hash + ')');
    if (target.length) {
      $('html, body').animate({ scrollTop: target.offset().top - 80 }, 400);
    }
  });
  if (location.hash) $(window).trigger('hashchange');
</script>

<%- include('partials/footer') %>
