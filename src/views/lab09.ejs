<%- include('partials/header', { title: 'Search — ByteNote', currentPage: '' }) %>

<div class="page-wrap wide">
  <div class="layout-cols">
    <main>
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span>Search</span>
      </div>

      <div class="page-header">
        <div class="page-header-eyebrow">Search</div>
        <h1>Search Articles</h1>
        <p>Find articles by topic, author, or keyword across the entire ByteNote archive.</p>
      </div>

      <div class="search-hero">
        <form class="search-hero-form" action="/lab09" method="get" autocomplete="off">
          <input type="text" name="search" placeholder="Search articles, topics, authors..."
                 value="<%= (typeof rawSearch !== 'undefined') ? rawSearch : '' %>">
          <button type="submit">Search</button>
        </form>
      </div>

      <!-- Results header populated by the JS analytics variable below -->
      <div id="search-output"></div>

      <div class="blog-list" style="margin-top:1rem;">
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(function(post) { %>
          <div class="blog-list-item">
            <div class="blog-list-category"><%= post.category %></div>
            <h2><a href="/articles/<%= post.id %>"><%= post.title %></a></h2>
            <div class="blog-list-excerpt"><%= post.excerpt %></div>
            <div class="blog-list-meta">
              <span><%= post.author %></span>
              <span>&middot;</span>
              <span><%= post.read_time %> min read</span>
            </div>
          </div>
          <% }); %>
        <% } %>
      </div>
    </main>

    <aside class="sidebar">
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Browse Topics</div>
        <div class="sidebar-tags">
          <a href="/lab09?search=xss" class="tag">XSS</a>
          <a href="/lab09?search=csp" class="tag">CSP</a>
          <a href="/lab09?search=dom" class="tag">DOM Security</a>
          <a href="/lab09?search=encoding" class="tag">Output Encoding</a>
          <a href="/lab09?search=penetration" class="tag">Pen Testing</a>
        </div>
      </div>
      <div class="sidebar-widget">
        <div class="sidebar-widget-title">Recent Articles</div>
        <ul class="sidebar-article-list">
          <li class="sidebar-article-item"><a href="/articles/1">Understanding Output Encoding</a><div class="sidebar-article-item-meta">Alice Chen &middot; 7 min</div></li>
          <li class="sidebar-article-item"><a href="/articles/3">DOM-Based XSS Explained</a><div class="sidebar-article-item-meta">Alice Chen &middot; 9 min</div></li>
          <li class="sidebar-article-item"><a href="/articles/5">Content Security Policy Guide</a><div class="sidebar-article-item-meta">Sarah Kim &middot; 11 min</div></li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<!-- Analytics variable — reflected XSS in JS string context; < > encoded, quotes/backslash NOT escaped -->
<script>
  var searchTerms = '<%- search %>';
  if (searchTerms) {
    document.getElementById('search-output').innerHTML =
      '<div class="search-results-header">Showing results for: ' + searchTerms + '</div>';
  }
</script>

<%- include('partials/footer') %>
